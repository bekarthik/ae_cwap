# Every value here has a working default. The platform runs end to end with
# none of them set: SQLite, an in-memory broker, and a deterministic stub model.
# Each variable below is what you change to move one piece toward production.

# ---- persistence -----------------------------------------------------------
# CWAP_DATABASE_URL=postgresql+psycopg://cwap:cwap@localhost:5432/cwap
# CWAP_SQL_ECHO=false

# ---- transport -------------------------------------------------------------
# "memory" (default) or "redis". With redis, run the worker as its own process.
# CWAP_BROKER=redis
# CWAP_REDIS_URL=redis://localhost:6379/0
# CWAP_WORK_QUEUE=cwap.jobs
# CWAP_DLQ=cwap.jobs.dlq
# Defaults to true only with the memory broker.
# CWAP_INLINE_WORKER=false

# ---- auth ------------------------------------------------------------------
# REQUIRED in any deployment. The default is a known development string.
# CWAP_JWT_SECRET=generate-with-openssl-rand-hex-32
# CWAP_JWT_TTL=43200

# Creates a demo account at startup. Only acts when a password is set, so a
# real deployment cannot ship a well-known credential by accident.
# CWAP_DEMO_EMAIL=demo@example.com
# CWAP_DEMO_PASSWORD=

# ---- model -----------------------------------------------------------------
# Any backend. See docs/models.md for the full table.
#   stub                             offline and deterministic (the default)
#   ollama vllm lmstudio llamacpp    open-weight models, local / self-hosted
#     tgi litellm
#   openai together groq openrouter  hosted OpenAI-compatible APIs
#     fireworks deepseek mistral
#   anthropic                        Claude via the official SDK
#   openai_compatible                anything else, with CWAP_LLM_BASE_URL

# Open-weight model on your own machine — no credentials needed:
# CWAP_LLM_PROVIDER=ollama
# CWAP_LLM_MODEL=llama3.1

# Overrides the preset's endpoint (e.g. Ollama on another host):
# CWAP_LLM_BASE_URL=http://gpu-box.internal:11434/v1
# CWAP_LLM_API_KEY=                  required by hosted providers
# CWAP_LLM_MAX_TOKENS=4096
# CWAP_LLM_TIMEOUT=120               raise this for large local models

# Honoured only where the backend supports it; the canvas hides the rest.
# CWAP_LLM_EFFORT=high               Anthropic only
# CWAP_LLM_TEMPERATURE=0.7           OpenAI-compatible backends only

# CWAP_LLM_PROVIDER=anthropic
# CWAP_LLM_MODEL=claude-opus-5
# ANTHROPIC_API_KEY=

# ---- embeddings (RAG) -------------------------------------------------------
# "hashing" is the offline default: lexical, deterministic, no credentials.
# Any OpenAI-compatible /embeddings endpoint works — Ollama, vLLM, LM Studio,
# OpenAI, Together, Mistral. Configured separately from the chat model, because
# they are frequently different services.
#
# Changing this invalidates existing corpora: retrieval refuses to compare
# vectors across embedding models and tells you to re-upload.
# CWAP_EMBEDDING_PROVIDER=ollama
# CWAP_EMBEDDING_MODEL=nomic-embed-text
# CWAP_EMBEDDING_BASE_URL=
# CWAP_EMBEDDING_API_KEY=
# CWAP_EMBEDDING_TIMEOUT=60

# ---- execution limits ------------------------------------------------------
# CWAP_MAX_STEPS=50
# CWAP_HTTP_TIMEOUT=20
# Comma-separated hosts an HTTP node may call. Empty (the default) blocks all
# outbound calls — a workflow is user-authored content executed server-side, so
# unrestricted egress would be an SSRF primitive.
# CWAP_HTTP_ALLOWLIST=api.example.com,hooks.slack.com

# ---- frontend --------------------------------------------------------------
# CWAP_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# NEXT_PUBLIC_API_BASE=http://localhost:8000   (set in web/, baked in at build)
