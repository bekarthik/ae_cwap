FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Dependency metadata first, so a source-only change reuses the install layer.
COPY pyproject.toml ./
COPY packages ./packages
COPY services ./services

# `mcp` belongs here for the same reason the others do: the image ships the
# feature, so the image needs the library. Leaving it out was invisible — the
# connector imports it lazily, so the app booted, the catalogue rendered, and
# only *connecting* failed, as a timeout rather than as a missing import.
RUN pip install --no-cache-dir -e ".[queue,llm,postgres,mcp]"

# The application never needs to write to its own source tree.
RUN useradd --create-home --uid 10001 cwap && chown -R cwap:cwap /app
USER cwap

EXPOSE 8000

CMD ["uvicorn", "api_gateway.app:app", "--host", "0.0.0.0", "--port", "8000"]
